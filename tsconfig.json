{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,

    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "three": ["node_modules/@types/three"],
      "three/addons/*": ["node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": ["game/js/**/*.ts"]
}
