{
  "name": "gde-groningen",
  "productName": "GDE Groningen",
  "version": "0.53.0",
  "description": "GDE Groningen – Zomer vol misdaad (GDE: Grootste Diefstal Ever)",
  "author": "NatusPella",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "desktopName": "gde-groningen.desktop",
  "scripts": {
    "stage": "node build.mjs",
    "start": "npm run stage && electron .",
    "dist:mac": "npm run stage && electron-builder --mac --universal",
    "dist:win": "npm run stage && electron-builder --win --x64",
    "dist:linux": "npm run stage && electron-builder --linux",
    "dist": "npm run stage && electron-builder --mac --universal && electron-builder --win --x64",
    "release": "sh release.sh",
    "web": "node ../web/build.mjs",
    "web:zip": "node ../web/build.mjs --zip",
    "web:serve": "node ../web/serve.mjs",
    "android:stage": "npm --prefix ../android run stage",
    "android:build": "npm --prefix ../android run build"
  },
  "build": {
    "appId": "nl.natuspella.gde-groningen",
    "productName": "GDE Groningen",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "args.cjs",
      "steamflags.cjs",
      "coopcore.cjs",
      "livebussen.cjs",
      "devtools.js",
      "preload.js",
      "trailervideo.js",
      "userdata.js",
      "envcompat.js",
      "resources/window-icon.png",
      "resources/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/game",
        "to": "game"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.games",
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "GDE Groningen ${version}",
      "artifactName": "GDE-Groningen-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "resources/icon.ico",
      "legalTrademarks": "GDE Groningen"
    },
    "portable": {
      "artifactName": "GDE-Groningen-${version}-windows-portable.exe",
      "unpackDirName": "GDE-Groningen"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Game",
      "executableName": "gde-groningen",
      "synopsis": "Zomer vol misdaad in Groningen",
      "artifactName": "GDE-Groningen-${version}-linux.${ext}",
      "syncDesktopName": true
    },
    "toolsets": {
      "nsis": "1.2.1",
      "appimage": "1.0.3"
    },
    "copyright": "© 2026 NatusPella",
    "nsis": {
      "shortcutName": "GDE Groningen"
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0",
    "global-agent": "^4.1.3"
  }
}
